{
  // Code run by Node: data scripts, the new-map skill script, the Vite config. The Vite
  // config imports the style registry, whose lazy loaders reach browser code: hence "dom"
  // and "vite/client".
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["es2024", "dom"],
    "module": "nodenext",
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "scripts", ".claude/skills/new-map/scripts", "places", "tests"]
}
